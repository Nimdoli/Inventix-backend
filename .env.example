# Copy this file to .env and fill in your real Supabase project values.
# Settings > Database (connection string) and Settings > API (JWT secret, project URL).

DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=[YOUR-JWT-SECRET-FROM-SETTINGS-API]
