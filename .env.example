# Copy this file to .env and fill in your real Supabase project values.
# DATABASE_URL: Connect button (top of project dashboard) -> Direct tab.
#   Remember to percent-encode special characters in your password
#   (e.g. @ -> %40, # -> %23) or SQLAlchemy won't parse the URL correctly.
# SUPABASE_URL: Settings -> API Keys -> Project URL.
#   No JWT secret needed here — this project uses the newer asymmetric
#   JWT Signing Keys system, so the backend verifies tokens against
#   Supabase's public JWKS endpoint instead of a shared secret.

DATABASE_URL=postgresql://postgres:[YOUR-URL-ENCODED-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
